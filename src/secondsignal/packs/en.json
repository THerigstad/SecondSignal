{
  "pack": "en",
  "version": 1,
  "status": "unreviewed",
  "language": "en",
  "window": 4,
  "note": "English idiom masks. A mask is a pre-filter, not a second crisis list: it marks a span as a known non-crisis construction so the matcher does not fire on it. Every window mask needs an object inside +/-window tokens; no object, no mask. Every mask carries a positive fixture (object present -> PROCEED) and a negative fixture (object absent -> HIT or seat-claim), enforced by tests/test_lexicon.py.",
  "negation": [
    "not",
    "don't",
    "dont",
    "never",
    "no",
    "won't",
    "wont",
    "cannot",
    "can't",
    "cant"
  ],
  "pivots": [
    "honestly",
    "seriously",
    "actually",
    "truly",
    "genuinely",
    "frankly",
    "sincerely"
  ],
  "regex_masks": [
    {
      "id": "labor_killing_me",
      "pattern": "\\bkilling (me|it|him|her|them|us|my \\w+|the \\w+)\\b"
    },
    {
      "id": "killed_it",
      "pattern": "\\bkilled it\\b"
    },
    {
      "id": "kill_it_time_lights",
      "pattern": "\\bkill (it|time|the (lights|mood|vibe|engine)|two birds)\\b"
    },
    {
      "id": "dying_to",
      "pattern": "\\bdying (to|of laughter|laughing|of embarrassment)\\b"
    },
    {
      "id": "die_laughing",
      "pattern": "\\bdie laughing\\b"
    },
    {
      "id": "died_laughing",
      "pattern": "\\bdied (laughing|of laughter)\\b"
    },
    {
      "id": "die_of_embarrassment",
      "pattern": "\\bdie of embarrassment\\b"
    },
    {
      "id": "to_die_for",
      "pattern": "\\bto die for\\b"
    },
    {
      "id": "dead_compound",
      "pattern": "\\bdead (tired|serious|end|ends|on|set|wrong|silent|quiet|last|centre|center|weight|zone)\\b"
    },
    {
      "id": "drop_dead",
      "pattern": "\\bdrop[- ]dead\\b"
    },
    {
      "id": "deadline_killswitch",
      "pattern": "\\b(dead|kill)(pan|lock|bolt|switch|beat|heat|wood|weight)\\b",
      "note": "Compounds that contain a stem. 'deadline' was removed from this list in round 2: word boundaries already keep it out of the stem patterns, and blanking it hid the career signal and the object the labor masks look for."
    },
    {
      "id": "device_died",
      "pattern": "\\b(my|the) (phone|battery|car|engine|laptop|computer|app|server|wifi|internet|plant|fish|screen|mic) (just |finally |again )?(died|is dead|dies|keeps dying)( again)?\\b"
    },
    {
      "id": "game_death",
      "pattern": "\\b(die|died|dying|dead|kill(ed)?|killing|unalived?) (in|on|at|during) (this|the|a|that|my|every) (boss fight|boss|game|level|raid|match|round|run|campaign|dungeon|pvp|mission)\\b"
    },
    {
      "id": "character_died",
      "pattern": "\\bmy (character|guy|hero|avatar|team|squad|party) (died|is dead|got killed|keeps dying)\\b"
    },
    {
      "id": "done_with_work",
      "pattern": "\\b(done|finished|through) with (the|this|that|my|these|those|it|him|her|them|work|school)\\b"
    },
    {
      "id": "give_up_on",
      "pattern": "\\bgive up on\\b"
    },
    {
      "id": "im_dead_slang",
      "pattern": "\\bi'?m dead\\b(?! inside)"
    },
    {
      "id": "suicide_prevention_noun",
      "pattern": "\\bsuicide (prevention|hotline|lifeline|awareness|research|rate|rates|squad|mission)\\b"
    },
    {
      "id": "disappear_for_a_while",
      "pattern": "\\bdisappear (for|on|over) (a|the|one|two|three) (week|weekend|day|days|while|bit|month|vacation|trip)\\b"
    },
    {
      "id": "end_of_meeting",
      "pattern": "\\bend (of )?(this|the) (meeting|call|session|chapter|year|day|week|sprint|quarter)\\b"
    },
    {
      "id": "end_of_quarter",
      "pattern": "\\bend of the (quarter|year|day|week|month)\\b"
    },
    {
      "id": "slay",
      "pattern": "\\bslay(ed|s)?\\b"
    },
    {
      "id": "sobering_thought",
      "pattern": "\\bsobering (thought|reminder|moment|look|read|reality)\\b"
    },
    {
      "id": "aa_batteries",
      "pattern": "\\baa (batteries|battery)\\b"
    },
    {
      "id": "death_of_me",
      "pattern": "\\b(the|a) death of me\\b",
      "note": "Emphasis idiom: 'this deadline will be the death of me'. Not grief, not risk."
    }
  ],
